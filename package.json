{
	"name": "@elecdeer/stylelint-rscss",
	"description": "Validate CSS (and SCSS, Less, SugarSS) to RSCSS conventions",
	"version": "2.0.0",
	"author": "elecdeer (https://github.com/elecdeer)",
	"contributors": [
		"Rico Sta. Cruz <rico@ricostacruz.com> (http://ricostacruz.com)"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elecdeer/stylelint-rscss.git"
	},
	"bugs": {
		"url": "https://github.com/elecdeer/stylelint-rscss/issues"
	},
	"homepage": "https://github.com/elecdeer/stylelint-rscss#readme",
	"directories": {
		"doc": "docs"
	},
	"keywords": [
		"css",
		"rscss",
		"sass",
		"scss",
		"stylelint",
		"stylelint-config",
		"stylelint-plugin"
	],
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./config": {
			"types": "./dist/config.d.mts",
			"default": "./dist/config.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest --run",
		"check:type": "tsc --noEmit",
		"check:biome": "biome ci",
		"build": "tsdown",
		"changeset": "changeset"
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
	"dependencies": {
		"postcss": "^8.5.6",
		"postcss-resolve-nested-selector": "^0.1.6",
		"postcss-selector-parser": "^7.1.1",
		"stylelint-scss": "^7.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@types/node": "~20.19.30",
		"@types/postcss-resolve-nested-selector": "^0.1.3",
		"postcss-scss": "^4.0.9",
		"stylelint": "^17.1.0",
		"tsdown": "^0.20.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"vitest-stylelint-utils": "^2.0.0"
	},
	"peerDependencies": {
		"stylelint": "^16.8.2 || ^17.0.0"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
